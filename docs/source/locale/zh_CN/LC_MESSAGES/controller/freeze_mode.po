msgid "**System Behavior in Freeze Mode:**"
msgstr ""

#: ../../source/controller/freeze_mode.rst:84
msgid "Cache retrieval operations continue to work"
msgstr ""

#: ../../source/controller/freeze_mode.rst:85
msgid "Only LocalCPUBackend is used for all retrievals"
