msgid "enable_lazy_memory_allocator"
msgstr ""

#: ../../source/api_reference/configurations.rst:118
msgid "LMCACHE_ENABLE_LAZY_MEMORY_ALLOCATOR"
msgstr ""

#: ../../source/api_reference/configurations.rst:119
msgid ""
"Whether to enable lazy memory allocator. Values: true/false. Default: "
"false"
msgstr ""

#: ../../source/api_reference/configurations.rst:120
msgid "lazy_memory_initial_ratio"
msgstr ""

#: ../../source/api_reference/configurations.rst:121
msgid "LMCACHE_LAZY_MEMORY_INITIAL_RATIO"
msgstr ""

#: ../../source/api_reference/configurations.rst:122
